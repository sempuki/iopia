load("@lib//bazel:copts.bzl", "COPTS")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "argument",
    hdrs = ["argument.hpp"],
    copts = COPTS,
    deps = ["@lib//base:core"],
)

cc_library(
    name = "io_error",
    srcs = ["io_error.cpp"],
    hdrs = ["io_error.hpp"],
    copts = COPTS,
    deps = [
        "@lib//base:core",
        "@lib//base:status",
    ],
)

cc_library(
    name = "ring",
    srcs = ["ring.cpp"],
    hdrs = ["ring.hpp"],
    copts = COPTS,
    deps = [
        ":argument",
        ":io_error",
        "//3rd_party:liburing",
        "@lib//base:core",
        "@lib//base:status",
    ],
)

cc_library(
    name = "operation",
    hdrs = ["operation.hpp"],
    copts = COPTS,
    deps = [
        ":ring",
        "@lib//base:core",
    ],
)

cc_library(
    name = "loop",
    srcs = ["loop.cpp"],
    hdrs = ["loop.hpp"],
    copts = COPTS,
    deps = [
        ":argument",
        ":io_error",
        ":operation",
        ":ring",
        "//3rd_party:liburing",
        "@lib//base:core",
        "@lib//base:status",
    ],
)

cc_library(
    name = "task",
    hdrs = ["task.hpp"],
    copts = COPTS,
    deps = [
        ":argument",
        ":io_error",
        ":loop",
        "@lib//base:core",
        "@lib//base:status",
    ],
)

cc_library(
    name = "request",
    hdrs = ["request.hpp"],
    copts = COPTS,
    deps = [
        ":io_error",
        "//3rd_party:liburing",
        "@lib//base:status",
    ],
)

cc_library(
    name = "awaitable",
    hdrs = ["awaitable.hpp"],
    copts = COPTS,
    deps = [
        ":argument",
        ":loop",
        ":operation",
        ":request",
        ":ring",
        "//3rd_party:liburing",
        "@lib//base:core",
    ],
)

cc_library(
    name = "sender",
    hdrs = ["sender.hpp"],
    copts = COPTS,
    deps = [
        ":argument",
        ":io_error",
        ":loop",
        "@lib//base:core",
        "@lib//base:status",
    ],
)

cc_library(
    name = "request_sender",
    hdrs = ["request_sender.hpp"],
    copts = COPTS,
    deps = [
        ":argument",
        ":loop",
        ":operation",
        ":request",
        ":ring",
        ":sender",
        "//3rd_party:liburing",
        "@lib//base:core",
    ],
)

[cc_test(
    name = test + "_test",
    size = "small",
    srcs = [test + "_test.cpp"],
    copts = COPTS,
    deps = [
        ":" + test,
        "@lib//base:testing",
    ] + extra_deps,
) for test, extra_deps in [
    ("awaitable", [":task"]),
    ("loop", []),
    ("request_sender", []),
    ("ring", []),
    ("sender", [":request_sender"]),
    ("task", [":awaitable"]),
]]
